{
  "name": "event-driven-generative-agent",
  "private": true,
  "type": "module",
  "description": "Kafe virtual: event-driven + generative agent",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @cafe/server",
    "seed": "npm run seed -w @cafe/server",
    "demo:stage1": "npm run demo:stage1 -w @cafe/server",
    "dev": "npm run dev -w @cafe/server",
    "demo:stage2": "npm run demo:stage2 -w @cafe/server",
    "watch": "npm run watch -w @cafe/server --",
    "demo:stage3": "npm run demo:stage3 -w @cafe/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
