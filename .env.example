# Copy to .env and adjust. Every setting is optional: the defaults are shown.
# Relative paths resolve from the repo root.

# Where the world is stored.
DATABASE_PATH=data/cafe.db

# HTTP API of the cashier mock and the time controls (127.0.0.1 only).
PORT=3000

# Virtual seconds per real second, 1 to 3600. 60 means one real second is one virtual minute.
SPEED=60

# Scenario. SEED only matters when a NEW world is created: an existing world keeps its own seed.
SEED=42
# How busy the cafe is, in percent of the normal day (100 = normal, 200 = twice as many orders). The server
# starts at 150 so that something happens often; with 250 and more one cook falls hours behind.
CROWD_PCT=150
# Chance in percent that an order that waited COMPLAINT_WAIT_MIN virtual minutes becomes a complaint.
COMPLAINT_CHANCE_PCT=15
# After how many virtual minutes of waiting an unserved order can turn into a complaint. The cashier
# handles a complaint by herself under 40 minutes of waiting; from 40 minutes on she brings a report with
# a compensation to the boss (a discount under 60 minutes, a free item from 60). Try 45 or 65 to see it.
COMPLAINT_WAIT_MIN=20

# Who helps the stock admin decide (what to order, and the review of the day). `fake` answers from a script
# without any model, `off` leaves every decision to the rules. A real local model comes in stage 6.
LLM_PROVIDER=fake
